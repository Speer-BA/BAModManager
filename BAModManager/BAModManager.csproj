<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <AssemblyName>BAModManager</AssemblyName>
    <RootNamespace>BAModManager</RootNamespace>
    <Product>Broken Arrow Mod Manager</Product>
    <Authors>Speer</Authors>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\BAModManager.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inter (SIL Open Font License) - the typeface Broken Arrow's UI uses -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\BAModManager.ico" LogicalName="Assets.icon.ico" />
    <EmbeddedResource Include="Assets\logo.png" LogicalName="Assets.logo.png" />
    <EmbeddedResource Include="Assets\default_preview.png" LogicalName="Assets.default_preview.png" />
    <None Update="Fonts\Inter-LICENSE.txt"
          Link="Inter-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
